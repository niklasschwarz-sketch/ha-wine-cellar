{
 "__inputs": [
  {
   "name": "DS_WINECELLAR",
   "label": "Wine cellar database",
   "description": "A PostgreSQL data source that points at the winecellar database",
   "type": "datasource",
   "pluginId": "grafana-postgresql-datasource",
   "pluginName": "PostgreSQL"
  }
 ],
 "title": "Wine cellar",
 "uid": "wine-cellar",
 "tags": [
  "wine"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "",
 "time": {
  "from": "now-12M",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Bottles",
   "type": "stat",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "${DS_WINECELLAR}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "${DS_WINECELLAR}"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT COALESCE(SUM(quantity),0) AS bottles FROM wc_wines"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value"
   }
  },
  {
   "id": 2,
   "title": "Estimated value",
   "type": "stat",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "${DS_WINECELLAR}"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "${DS_WINECELLAR}"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT COALESCE(SUM(quantity*value),0) AS value FROM wc_wines"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyEUR"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value"
   }
  },
  {
   "id": 3,
   "title": "Paid",
   "type": "stat",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "${DS_WINECELLAR}"
   },
   "gridPos": {
    "x": 9,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "${DS_WINECELLAR}"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT COALESCE(SUM(quantity*price),0) AS paid FROM wc_wines WHERE price > 0"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyEUR"
    },
    "overrides": []
