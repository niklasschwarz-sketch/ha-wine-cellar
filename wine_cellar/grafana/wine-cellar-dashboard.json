  {
   "id": 11,
   "title": "Biggest gains and losses",
   "type": "table",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "${DS_WINECELLAR}"
   },
   "gridPos": {
    "x": 0,
    "y": 29,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "${DS_WINECELLAR}"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT producer, wine, vintage, quantity, price, value, (value-price)*quantity AS gain FROM wc_v_cellar WHERE price > 0 AND value > 0 AND value <> price ORDER BY ABS((value-price)*quantity) DESC LIMIT 20"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
