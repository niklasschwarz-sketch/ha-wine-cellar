  {
   "id": 6,
   "title": "Bottles by region",
   "type": "barchart",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "${DS_WINECELLAR}"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "${DS_WINECELLAR}"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT region, SUM(bottles) AS bottles FROM wc_v_by_region GROUP BY region ORDER BY bottles DESC LIMIT 15"
