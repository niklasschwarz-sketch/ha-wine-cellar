+    for b in db.run("SELECT wine_id, rack_id, shelf, slot FROM wc_bottles ORDER BY rack_id, shelf, slot", fetch="all"):
+        by.setdefault(b["wine_id"], []).append("%s %d/%d" % (names.get(b["rack_id"], "?"), b["shelf"], b["slot"]))
+    return by
+
